{
  "name": "COOKIEBOT-NEXTJS",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:static": "WEBHUB_EXPORT=1 next build",
    "build:assets": "bun scripts/embed-assets.ts",
    "build:server": "scriptc build server/main.ts -o dist/webhub --strip --no-keep-llvm",
    "build:binary": "bun run build:static && bun run build:assets && bun run build:server"
  },
  "dependencies": {
    "@heroicons/react": "^2.1.5",
    "@tanstack/react-query": "^5.75.2",
    "@telegram-auth/react": "^1.0.4",
    "axios": "^1.9.0",
    "clsx": "^2.1.1",
    "echarts": "^5.6.0",
    "framer-motion": "^11.3.19",
    "jwt-decode": "^4.0.0",
    "next": "14.2.5",
    "next-intl": "^3.17.2",
    "next-themes": "^0.3.0",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "postcss": "^8",
    "sass": "^1.77.8",
    "scriptc": "0.2.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "type": "module",
  "allowScripts": {
    "scriptc@0.2.0": true
  },
  "trustedDependencies": [
    "scriptc"
  ]
}
