# Runtime configuration. The same values drive `next dev` (from .env.local)
# and the native server / Docker image (from the environment). Nothing is
# baked in at build time: one image serves every environment.
# Resolved by src/lib/cb/server-config.ts.

# Environment this deployment serves: local | dev | prd
# (default: prd for the native server, local under `next dev`).
CB_ENV=

# Base URL of the Cookiebot v2 API for CB_ENV. The browser never sees it:
# it calls /cb/<env>/..., which the server proxies here.
CB_API_URL=

# Per-environment URLs. Under `next dev` the environment selector lists every
# one that is set (local defaults to http://localhost:8000, `scripts/cb.py api`).
CB_API_URL_LOCAL=
CB_API_URL_DEV=
CB_API_URL_PRD=

# Bot behind the Telegram Login Widget (default CookieMWbot).
TELEGRAM_BOT_USERNAME=

# "mock" serves group settings from memory with no API calls (UI work).
SETTINGS_BACKEND=

# v1/v2 design switcher: "false" hides it; DESIGN_DEFAULT is v1 or v2 (default v2).
DESIGN_SWITCHER=
DESIGN_DEFAULT=

# v1 botserver behind /api/botserver (group count on the Set Up screen).
BOTSERVER_URL=

# Native server only.
PORT=3000
HOST=0.0.0.0
